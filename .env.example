# Yandex AI Studio — YandexGPT. Copy to .env and fill in; .env stays on the server.
# API key of a service account with the ai.languageModels.user role:
YANDEX_API_KEY=
# Folder id in Yandex Cloud (the model is gpt://<folder>/yandexgpt/latest):
YANDEX_FOLDER_ID=
# Port of the server (the app and /api):
PORT=8787
